{
  "$schema": "../../registry-item.schema.json",
  "name": "email-smtp",
  "version": "1.0.0",
  "type": "outlet:adapter",
  "concern": "email",
  "description": "SMTP adapter for IEmailSender, backed by MailKit.",
  "targetFrameworks": ["net8.0", "net9.0", "net10.0"],
  "registryDependencies": ["email-abstractions"],
  "nugetDependencies": [
    { "id": "MailKit", "version": "4.16.0" }
  ],
  "files": [
    { "path": "SmtpEmailOptions.cs", "target": "adapter" },
    { "path": "SmtpEmailSender.cs", "target": "adapter" },
    { "path": "SmtpEmailServiceCollectionExtensions.cs", "target": "adapter" }
  ]
}
