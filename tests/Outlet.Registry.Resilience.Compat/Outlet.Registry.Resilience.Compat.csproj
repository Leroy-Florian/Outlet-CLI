<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build the registry sources against EVERY declared targetFramework so the
         manifest's compatibility claim is verified, not merely asserted. Build-only:
         no tests, no runtime needed for the older TFMs. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Outlet.Registry.Resilience</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../registry/resilience/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Polly" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
