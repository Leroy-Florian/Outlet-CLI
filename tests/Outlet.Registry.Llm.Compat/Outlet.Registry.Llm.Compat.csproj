<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build the registry sources against EVERY declared targetFramework so the
         manifest's compatibility claim is verified, not merely asserted (HIJ-509).
         Build-only: no tests, no runtime needed for the older TFMs. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>Outlet.Registry.Llm</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../registry/llm/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Anthropic.SDK" />
    <PackageReference Include="Mscc.GenerativeAI" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
