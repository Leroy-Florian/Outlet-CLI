<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Archetype: a modern single-project app on the current TFM, using Central Package
    Management (Directory.Packages.props) and a DI container. Proves Outlet writes a
    versionless <PackageReference> here and parks the version centrally, and that the
    adapter resolves through AddInMemoryCache() / GetRequiredService<ICacheStore>().
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Acme.Modern</RootNamespace>
  </PropertyGroup>

  <!-- Versionless: under CPM the version lives in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
